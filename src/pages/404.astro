---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="not-found section-pad">
    <div class="shell not-found-inner">
      <p class="eyebrow">404</p>
      <h1>This page is not in the model.</h1>
      <p>The link may have changed, or the page may not exist.</p>
      <div class="button-row">
        <a class="button button-primary" href="/">Return home</a>
        <a class="button button-secondary" href="/projects/">Browse projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
