---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Contact Nancy Truong about data science, analytics, machine learning, and professional opportunities."
>
  <section class="contact-page">
    <div class="contact-decoration" aria-hidden="true">
      <span>μ</span>
      <span>42</span>
      <span>ŷ</span>
    </div>

    <div class="shell contact-container">
      <div class="contact-intro">

        <div class="contact-intro-heading">
          <p class="eyebrow contact-role">
            Mathematical Statistics · Data science · Sweden
          </p>

          <h1>Nancy Truong</h1>
        </div>

        <p class="contact-description">
          Whether it is about data, statistics, machine learning,
          an opportunity, or simply something interesting you would
          like to share, I would be happy to hear from you!
        </p>
      </div>


      <div class="contact-methods">
        <div class="contact-methods-heading">
          <p class="eyebrow">Contact</p>
        </div>

        <!-- Email -->
<article class="contact-card">

<a
  class="contact-card-link"
  href="mailto:nancy.my.truong@gmail.com"
>
    <span class="contact-card-icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect
          x="4"
          y="6"
          width="16"
          height="12"
          rx="1"
        />

        <path d="m4 8 8 6 8-6" />
      </svg>
    </span>

    <span class="contact-card-content">
      <span class="contact-card-label">Email</span>
      <strong>{site.email}</strong>
    </span>
  </a>

  <button
    class="contact-copy-button"
    type="button"
    data-copy-value={site.email}
    data-copy-name="Email address"
    aria-label="Copy email address"
    title="Copy email address"
  >
    <svg
      viewBox="0 0 24 24"
      width="19"
      height="19"
      aria-hidden="true"
    >
      <rect
        x="8"
        y="8"
        width="11"
        height="11"
        rx="2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
      />

      <path
        d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
      />
    </svg>
  </button>
</article>

        <!-- LinkedIn -->
        <article class="contact-card">
          <a
            class="contact-card-link"
            href={site.links.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit Nancy Truong on LinkedIn"
          >
            <span class="contact-card-icon" aria-hidden="true">
              in
            </span>

            <span class="contact-card-content">
              <span class="contact-card-label">LinkedIn</span>
              <strong>{site.links.linkedin}</strong>
            </span>
          </a>

          <button
            class="contact-copy-button"
            type="button"
            data-copy-value={site.links.linkedin}
            data-copy-name="LinkedIn link"
            aria-label="Copy LinkedIn link"
            title="Copy LinkedIn link"
          >
            <svg
              viewBox="0 0 24 24"
              width="19"
              height="19"
              aria-hidden="true"
            >
              <rect
                x="8"
                y="8"
                width="11"
                height="11"
                rx="2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
              />

              <path
                d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </article>

        <!-- GitHub -->
        <article class="contact-card">
          <a
            class="contact-card-link"
            href={site.links.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit Nancy Truong on GitHub"
          >
            <span class="contact-card-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="21"
                  height="21"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M15 22v-4a4.8 4.8 0 0 0-1-3.5
                    c3.3-.4 6.8-1.6 6.8-7
                    A5.4 5.4 0 0 0 19.4 4
                    A5 5 0 0 0 19.3.5
                    S18.1.1 15 1.8
                    a13.4 13.4 0 0 0-7 0
                    C4.9.1 3.7.5 3.7.5
                    A5 5 0 0 0 3.6 4
                    a5.4 5.4 0 0 0-1.4 3.7
                    c0 5.4 3.5 6.6 6.8 7
                    A4.8 4.8 0 0 0 8 18v4"
                  />

                  <path d="M8 19c-3 .9-3-1.5-4-2" />
                </svg>
              </span>

            <span class="contact-card-content">
              <span class="contact-card-label">GitHub</span>
              <strong>{site.links.github}</strong>
            </span>
          </a>

          <button
            class="contact-copy-button"
            type="button"
            data-copy-value={site.links.github}
            data-copy-name="GitHub link"
            aria-label="Copy GitHub link"
            title="Copy GitHub link"
          >
            <svg
              viewBox="0 0 24 24"
              width="19"
              height="19"
              aria-hidden="true"
            >
              <rect
                x="8"
                y="8"
                width="11"
                height="11"
                rx="2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
              />

              <path
                d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </article>

        <p
          class="copy-status"
          data-copy-status
          role="status"
          aria-live="polite"
        ></p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  type ContactWindow = Window & {
    __contactPageController?: AbortController;
  };

  const copyText = async (value: string) => {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(value);
      return;
    }

    const temporaryInput =
      document.createElement('textarea');

    temporaryInput.value = value;
    temporaryInput.style.position = 'fixed';
    temporaryInput.style.opacity = '0';

    document.body.appendChild(temporaryInput);
    temporaryInput.select();

    const copied =
      document.execCommand('copy');

    temporaryInput.remove();

    if (!copied) {
      throw new Error('Copy failed');
    }
  };

  const setupContactPage = () => {
    const contactWindow =
      window as ContactWindow;

    contactWindow.__contactPageController?.abort();

    const controller =
      new AbortController();

    const { signal } = controller;

    contactWindow.__contactPageController =
      controller;

    const buttons =
      document.querySelectorAll<HTMLButtonElement>(
        '[data-copy-value]'
      );

    const status =
      document.querySelector<HTMLElement>(
        '[data-copy-status]'
      );

    buttons.forEach((button) => {
  button.addEventListener(
    'click',
    async () => {
      const value = button.dataset.copyValue;

      if (!value) {
        return;
      }

      const originalContent = button.innerHTML;
      const originalLabel =
        button.getAttribute('aria-label') ?? 'Copy';

      try {
        await copyText(value);

        button.classList.add('is-copied');
        button.setAttribute(
          'aria-label',
          'Copied'
        );

        button.innerHTML = `
          <svg
            viewBox="0 0 24 24"
            width="19"
            height="19"
            aria-hidden="true"
          >
            <path
              d="M5 12.5l4 4L19 7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        `;

        window.setTimeout(() => {
          button.innerHTML = originalContent;
          button.classList.remove('is-copied');
          button.setAttribute(
            'aria-label',
            originalLabel
          );
        }, 1600);
      } catch {
        console.error('Could not copy the value.');
      }
    },
    { signal }
  );
});
  };

  setupContactPage();

  document.addEventListener(
    'astro:page-load',
    setupContactPage
  );
</script>

<style>
  .contact-page {
  position: relative;
  overflow: hidden;
  padding: clamp(2rem, 6vw, 6rem) 0;
}

  .contact-container {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns:
    minmax(430px, 0.9fr)
    minmax(0, 1.1fr);
  align-items: stretch;
  max-width: 1180px;
  overflow: hidden;
  border: 1px solid
    color-mix(
      in srgb,
      var(--accent) 35%,
      var(--line)
    );
  border-radius: clamp(1.25rem, 2vw, 2rem);
  background: var(--surface);
  box-shadow:
    0 18px 50px
    color-mix(
      in srgb,
      var(--accent) 9%,
      transparent
    );
  }

  .contact-intro {
  display: grid;
  min-width: 0;
  align-content: center;
  justify-items: start;
  padding: clamp(2.25rem, 4vw, 4rem);
  border-right: 1px solid var(--line);
  background: var(--surface);
  text-align: left;
}

  .contact-intro-heading {
  width: 100%;
  min-width: 0;
  margin: 0 0 1.35rem;
}

  .contact-portrait {
  width: clamp(170px, 16vw, 215px);
  justify-self: center;
  margin: 0 0 2rem;
  overflow: hidden;
  aspect-ratio: 1;
  border: 1px solid var(--line);
  border-radius: 24px;
  background: var(--paper);
}

  .contact-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .contact-role {
    width: 100%;
    margin: 0 0 0.7rem;
    white-space: nowrap;
  }

  .contact-intro .eyebrow {
    margin: 0 0 1rem;
  }

  .contact-intro-heading h1 {
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(2.5rem, 4vw, 3.8rem);
  font-weight: 500;
  line-height: 1;
  letter-spacing: -0.045em;
}

  .contact-intro-heading::after {
    display: block;
    width: 3.25rem;
    height: 1px;
    margin-top: 1.15rem;
    background: var(--accent);
    content: "";
  }

  .contact-description {
    width: 100%;
    max-width: 27rem;
    margin: 0;
    color: var(--text-soft);
    font-size: clamp(0.98rem, 1.2vw, 1.08rem);
    line-height: 1.75;
  }

  .contact-note {
    margin: 1.5rem 0 0;
    font-size: 0.9rem;
    opacity: 0.55;
  }

  .contact-methods {
  display: grid;
  min-width: 0;
  align-content: center;
  gap: 0.85rem;
  padding: clamp(2.25rem, 4vw, 4rem);
}

  .contact-card {
    position: relative;
    display: flex;
    align-items: stretch;
    min-width: 0;
    overflow: hidden;
    border: 1px solid
      color-mix(
        in srgb,
        currentColor 16%,
        transparent
      );
    border-radius: 1.1rem;
    background:
      color-mix(
        in srgb,
        currentColor 3.5%,
        transparent
      );
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .contact-card:hover {
    transform: translateY(-2px);
    border-color:
      color-mix(
        in srgb,
        currentColor 30%,
        transparent
      );
    background:
      color-mix(
        in srgb,
        currentColor 6%,
        transparent
      );
  }

  .contact-card-link {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  gap: 1rem;
  padding: 1.2rem 4.5rem 1.2rem 1.2rem;
  color: inherit;
  text-decoration: none;
}

  .contact-card-icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    flex: 0 0 auto;
    border: 1px solid
      color-mix(
        in srgb,
        currentColor 18%,
        transparent
      );
    border-radius: 0.85rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    background:
      color-mix(
        in srgb,
        currentColor 5%,
        transparent
      );
  }

  .contact-card-icon-code {
    font-size: 0.78rem;
  }

  .contact-card-content {
    display: grid;
    min-width: 0;
    flex: 1;
    gap: 0.25rem;
  }

  .contact-card-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .contact-card-content strong {
    display: block;
    min-width: 0;
    overflow: hidden;
    font-size: clamp(0.88rem, 1.15vw, 1rem);
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact-card-hint {
    font-size: 0.85rem;
    opacity: 0.55;
  }

.contact-copy-button {
  position: absolute;
  top: 50%;
  right: 1rem;
  display: grid;
  width: 2.5rem;
  height: 2.5rem;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 0.55rem;
  background: transparent;
  color: inherit;
  cursor: pointer;
  opacity: 0.55;
  transform: translateY(-50%);
  transition:
    opacity 160ms ease,
    background-color 160ms ease;
}

  .contact-copy-button:hover,
  .contact-copy-button:focus-visible {
    opacity: 1;
    background:
      color-mix(
        in srgb,
        currentColor 7%,
        transparent
      );
  }

  .contact-copy-button.is-copied {
    opacity: 1;
    background:
      color-mix(
        in srgb,
        currentColor 10%,
        transparent
      );
  }

  .contact-copy-button.is-copied svg {
    transform: scale(0.9);
  }

  .copy-status {
    min-height: 1.25rem;
    margin: 0.25rem 0 0;
    padding-left: 0.25rem;
    font-size: 0.85rem;
    opacity: 0.65;
  }

  .contact-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
  }

  .contact-decoration span {
    position: absolute;
    color: currentColor;
    font-family: Georgia, serif;
    opacity: 0.035;
  }

  .contact-decoration span:nth-child(1) {
    top: 8%;
    right: 7%;
    font-size: clamp(8rem, 20vw, 18rem);
  }

  .contact-decoration span:nth-child(2) {
    bottom: -5%;
    left: 3%;
    font-size: clamp(7rem, 16vw, 14rem);
  }

  .contact-decoration span:nth-child(3) {
    top: 46%;
    left: 44%;
    font-size: clamp(4rem, 9vw, 8rem);
  }

  /* Tablet */
/* Medium desktop */

@media (min-width: 981px) and (max-width: 1200px) {
  .contact-intro {
    padding-right: 1.5rem;
    padding-left: 2rem;
  }
}

@media (max-width: 980px) {
  .contact-page {
    padding: 2.5rem 0 4rem;
  }

  .contact-container {
    grid-template-columns: minmax(0, 1fr);
    max-width: 760px;
  }

  .contact-intro {
    justify-items: center;
    padding: clamp(2rem, 6vw, 3.5rem);
    border-right: 0;
    border-bottom: 1px solid var(--line);
    text-align: center;
  }

  .contact-portrait {
    width: clamp(150px, 28vw, 200px);
  }

  .contact-intro-heading::after {
    margin-right: auto;
    margin-left: auto;
  }

  .contact-description {
    max-width: 38rem;
  }

  .contact-methods {
    padding: clamp(2rem, 6vw, 3.5rem);
  }
}

/* Mobile */

@media (max-width: 560px) {
  .contact-page {
    padding: 1.25rem 0 3rem;
  }

  .contact-container {
    width: calc(100% - 24px);
    border-radius: 1.25rem;
  }

  .contact-intro {
    padding: 1.75rem 1.25rem 2rem;
  }

  .contact-portrait {
    width: 145px;
    margin-bottom: 1.5rem;
    border-radius: 20px;
  }

  .contact-role {
    max-width: 24rem;
    white-space: normal;
    text-align: center;
  }

  .contact-intro-heading h1 {
    font-size: clamp(2.25rem, 12vw, 3rem);
  }

  .contact-description {
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .contact-methods {
    padding: 1.75rem 1rem;
  }

  .contact-card-link {
    gap: 0.8rem;
    padding: 1rem 3.6rem 1rem 0.9rem;
  }

  .contact-card-icon {
    width: 2.75rem;
    height: 2.75rem;
  }

  .contact-card-content strong {
    font-size: 0.87rem;
  }

  .contact-copy-button {
    right: 0.65rem;
    width: 2.3rem;
    height: 2.3rem;
  }
}

</style>