---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="shell footer-main">
    <div class="footer-introduction">
      <a class="footer-name" href="/">
        {site.name}
      </a>

      <p>
      </p>

      <a class="footer-contact-link" href="/contact/">
        Let’s connect
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <nav
      class="footer-navigation"
      aria-label="Footer navigation"
    >
      <p class="footer-heading">Site Links</p>

      <a href="/">Home</a>
      <a href="/projects/">Projects</a>
      <a href="/contact/">Contact</a>
    </nav>

    <div class="footer-connect">
      <p class="footer-heading">Connect</p>

      <div
        class="footer-social-links"
        aria-label="Contact and social links"
      >
        <a
          href={`mailto:${site.email.trim()}`}
          aria-label={`Send an email to ${site.email}`}
          title="Email"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M4 5h16v14H4z"></path>
            <path d="m4 7 8 6 8-6"></path>
          </svg>
        </a>

        <a
          href={site.links.linkedin}
          target="_blank"
          rel="noreferrer"
          aria-label="Visit Nancy Truong on LinkedIn"
          title="LinkedIn"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M7 9v8"></path>
            <path d="M7 6.5v.01"></path>
            <path d="M11 17v-4.5a3 3 0 0 1 6 0V17"></path>
            <path d="M11 9v8"></path>
          </svg>
        </a>

        <a
          href={site.links.github}
          target="_blank"
          rel="noreferrer"
          aria-label="Visit Nancy Truong on GitHub"
          title="GitHub"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5
              c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0
              19.4 4 5 5 0 0 0 19.3.5
              S18.1.1 15 1.8a13.4 13.4 0 0 0-7 0
              C4.9.1 3.7.5 3.7.5A5 5 0 0 0
              3.6 4a5.4 5.4 0 0 0-1.4 3.7
              c0 5.4 3.5 6.6 6.8 7
              A4.8 4.8 0 0 0 8 18v4"
            ></path>

            <path
              d="M8 19c-3 .9-3-1.5-4-2"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="shell footer-bottom">


    <button
      class="back-to-top"
      type="button"
      data-back-to-top
      aria-label="Back to top of page"
    >
      <span>Back to top</span>

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="m6 15 6-6 6 6"></path>
      </svg>
    </button>
  </div>
</footer>

<script>
  const setupBackToTop = () => {
    const button = document.querySelector(
      '[data-back-to-top]'
    );

    if (
      !(button instanceof HTMLButtonElement) ||
      button.dataset.ready === 'true'
    ) {
      return;
    }

    button.dataset.ready = 'true';

    button.addEventListener('click', () => {
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      window.scrollTo({
        top: 0,
        behavior: reduceMotion
          ? 'auto'
          : 'smooth',
      });
    });
  };

  setupBackToTop();

  document.addEventListener(
    'astro:page-load',
    setupBackToTop
  );
</script>